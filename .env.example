
# Safe local defaults; replace service/model placeholders only in a local .env.
WANDB_MODE=disabled
WANDB_PROJECT=replace-with-project-name
WANDB_API_KEY=replace-me

# `none` avoids external Judge calls for local plumbing checks only.
MODEL_PROVIDER=vllm
VERIFIER_PROVIDER=none

QWEN_BASE_URL=https://example.invalid/v1
QWEN_MODEL=replace-with-model-name
QWEN_API_KEY=replace-me

DEEPSEEK_BASE_URL=https://example.invalid/v1
DEEPSEEK_MODEL=replace-with-model-name
DEEPSEEK_API_KEY=replace-me

VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=replace-with-served-model
VLLM_NATIVE_TOOL_CALLING=false

LOCAL_HF_MODEL_PATH=./models/original_model/REPLACE_ME
LOCAL_HF_MODEL_NAME=replace-with-model-name
